# Copy this file to .env and fill in your local backend values.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://scholar-backend-1tso.onrender.com/google_oauth_callback.php
# Optional if you want the callback to redirect into the app automatically.
GOOGLE_OAUTH_SUCCESS_URL=
# Comma-separated list of allowed web app origins for browser requests.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://your-frontend.onrender.com
# Optional explicit public base URL for generated file links.
PUBLIC_BASE_URL=https://your-backend.onrender.com
